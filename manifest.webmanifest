{
 "name": "Ávila Ruta",
 "short_name": "Ávila Ruta",
 "description": "Mapa y rutas del Ávila que funcionan sin señal, con indicaciones en cada cruce.",
 "lang": "es",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "portrait",
 "background_color": "#0a0a0a",
 "theme_color": "#0a0a0a",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any maskable"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./compartir",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "files": [
    {
     "name": "actividad",
     "accept": [
      ".fit",
      ".gpx",
      ".tcx",
      ".zip",
      "application/gpx+xml",
      "application/vnd.ant.fit",
      "application/octet-stream",
      "application/zip",
      "text/xml"
     ]
    }
   ]
  }
 }
}